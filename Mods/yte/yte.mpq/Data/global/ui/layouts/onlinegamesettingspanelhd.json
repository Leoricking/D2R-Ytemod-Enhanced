                "hoveredFrame": 0,
				"pressedFrame": 0,
                "onClickMessage": "PanelManager:TogglePanel:YtemodUptoVip",
                "tooltipString": "当前为共享版，升级至增值版，可解锁全部查询资料。\n点击查看升级方法。",
                "sound": "cursor_close_window_hd",
            },
        },
        {
            "type": "TabBarWidget", "name": "OptionsTabs",
            "fields": {
				"anchor": "$LeftPanelAnchor",
				"rect": "$MessagePanelTabBarRect",
                "tabCount": 7,
                "tabSize": { "x": 95, "y": 60, },
                "tabPadding": { "x": 3, "y": 0 },
                "unavailableTabsLeaveGaps": false,
                "tabSizingMethod": "fixedCenter",
                "filename": "PANEL\\message\\Boctabc",
                "inactiveFrames": [ 1, 1, 1, 1, 1, 1, 1 ],
                "activeFrames": [ 0, 0, 0, 0, 0, 0, 0 ],
                "activeTextColor": "$FontColorGoldYellow",
                "inactiveTextColor": "$TabsInactiveTextColor",
                "tabTextOffset": {
                    "x": 0,
                    "y": -15,
                },
                "textStyle": {
                    "options": {
                        "lineWrap": true
                    },
                    "pointSize": "$MediumFontSize",
                    "alignment": {
                        "h": "center",
                        "v": "center"
                    },
                    "fontColor": "$FontColorWhite",
                    "spacing": {
