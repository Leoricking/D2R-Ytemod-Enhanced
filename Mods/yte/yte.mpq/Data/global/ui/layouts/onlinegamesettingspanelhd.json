{
    "type": "SettingsPanel", "name": "OnlineGameSettingsPanel",
    "fields": {
        "priority": 100,
        "fitToParent": true,
    },
    "children": [
        {
            "type": "RectangleWidget", "name": "Background",
            "fields": {
				"anchor": "$LeftPanelAnchor",
				"rect": "$MessagePanelRect",
                "color": [ 0.0, 0.0, 0.0, 0.0 ]
            },
            "children": [
                {
                    "type": "ClickCatcherWidget", "name": "catcher",
                    "fields": {
						"rect": { "x": 0, "y": 0, "width": 875, "height": 1500 }
                    }
                },
                {
                    "type": "Widget", "name": "Anchor",
                    "fields": {
						"rect": { "x": 0, "y": 0 }
                    },
                    "children": [
                        {
                            "type": "ImageWidget", "name": "Background",
                            "fields": {
								"filename": "PANEL\\AdvancedCharacterSheet\\AdvancedCharacterSheet_BG",
                            },
                        },
                        {
                            "type": "TextBoxWidget", "name": "Title",
                            "fields": {
								"text": "@0scmsgp",
								"rect": { "x": 120, "y": 61, "width": 640, "height": 85 },
								"style": "$StyleTitleBlock"
								
                            },
                        },
                        {
                            "type": "ButtonWidget", "name": "CloseButton",
                            "fields": {
								"rect": { "x": 791, "y": 10 },
								"filename": "PANEL\\closebtn_4x",
								"hoveredFrame": 3,
								"onClickMessage": "SettingsPanelMessage:CheckChanges:Close",
								"tooltipString": "@strClose",
								"sound": "cursor_close_window_hd",
								"acceptsEscKeyEverywhere": true
                            },
                        },
                    ]
                },
            ]
        },
        {
            "type": "ButtonWidget", "name": "UptoVip",
            "fields": {
				"anchor": "$LeftPanelAnchor",
                "rect": { "x": 2000, "y": -591,"scale": 0.6 },
