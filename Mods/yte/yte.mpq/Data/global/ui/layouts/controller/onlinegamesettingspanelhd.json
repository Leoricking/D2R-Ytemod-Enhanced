{
    "basedOn": "OnlineGameSettingsPanelHD.json",
    "type": "SettingsPanel", "name": "OnlineGameSettingsPanel",
    "fields": {
        "fitToParent": true,
    },
    "children": [
        {
            "type": "ClickCatcherWidget", "name": "catcher",
			"fields": {
				"fitToParent": true
			}
        },
        {
            "type": "RectangleWidget", "name": "Background",
            "fields": {
                "fitToScreen": true,
                "color": [ 0.0, 0.0, 0.0, 0.0 ]
            },
            "children": [
                {
                    "type": "Widget", "name": "Anchor",
                    "fields": {
                        "anchor": { "x": 0.5, "y": 0.5 },
                        "rect": "$SettingsPanelAnchorRect",
                    },
                    "children": [
                        {
                            "type": "ImageWidget", "name": "Background",
                            "fields": {
                                 "filename": "Controller/Panel/MainPanelBG_Options",
                            },
                        },
                        {
                            "type": "TextBoxWidget", "name": "Title",
                            "fields": {
                                "rect": { "x": 0, "y": 45, "width": 1950, "height": 103 },
                                "text": "@0scmsgp",
                                "style": {
                                    "fontColor": "$FontColorVeryLightGray",
                                    "pointSize": "$LargeFontSize",
                                    "alignment": { "h": "center", "v": "center" },
                                },
                            },
                        },
                    ]
                },
            ]
        },
        {
            "type": "ImageWidget", "name": "SettingsBackground",
            "fields": {
                "rect": "$SettingsPanelBackgroundRect",
                "anchor": { "x": 0.5 },
                "filename": "Controller/Panel/Options/Panel_Options_BG",
				
            },
        },
        {
            "type": "TabBarWidget", "name": "OptionsTabs",
            "fields": {
                "tabLeftIndicatorPosition": { "x": 30, "y": -4 },
                "tabRightIndicatorPosition": { "x": 1700, "y": -4 },
                "rect": "$SettingsPanelTabsRect",
                "anchor": { "x": 0.5, "y": 0 },
                "tabCount": 7,
                "tabSize": { "x": 185, "y": 121, },
                "tabPadding": { "x": 2, "y": 0 },
                "unavailableTabsLeaveGaps": false,
                "tabSizingMethod": "fixedCenter",
                "filename": "Controller/Panel/Stash/V2/BocTabss",
                "inactiveFrames": [ 1, 1, 1, 1, 1, 1, 1 ],
                "activeFrames": [ 0, 0, 0, 0, 0, 0, 0 ],
                "activeTextColor": "$FontColorGoldYellow",
                "inactiveTextColor": "$TabsInactiveTextColor",
                "tabTextOffset": { "x": 0, "y": -4, },
                "textStyle": {
                    "options": { "lineWrap": true },
                    "pointSize": "$MediumFontSize",
                    "alignment": { "h": "center", "v": "center" },
                    "fontColor": "$FontColorWhite",
                    "spacing": {"leading":0.9, "kerning":0.95}
                },
                "textStrings": [ "ㆉ", "ㅪ", "ㅂ", "ㅅ", "㆐", "ㅲ", "ㆍ" ],
                "tabMessages": [
                    "SettingsPanelMessage:CheckChanges:BocCubeVPanel",
                    "SettingsPanelMessage:CheckChanges:BocRwVPanel",
                    "SettingsPanelMessage:CheckChanges:BocSetsVPanel",
                    "SettingsPanelMessage:CheckChanges:BocUniMVPanel",
                    "SettingsPanelMessage:CheckChanges:BocUniWVPanel",
                    "SettingsPanelMessage:CheckChanges:BocUniAVPanel",
                    "SettingsPanelMessage:CheckChanges:BocBasicVPanel",
                ],
            },
        },
    ]
}

