{
    "basedOn": "MiniCubeLayoutHD.json",
    "type": "HoradricCubePanel", "name": "MiniCubeLayout",
    "fields": {
        "priority": 10,
        "rect": "$ConsoleLeftPanelRect",
        "defaultWidget": "grid",
    },
    "children": [
        {
            "type": "ClickCatcherWidget", "name": "click_catcher",
            "fields": {
                "rect": [ 0, 0, 0, 0 ],
                "fitToParent": true
            }
        },
        {
            "type": "InventoryGridWidget", "name": "grid",
            "fields": {
                "rect": { "x": 75, "y": 1240, "scale": 0.8 },
                "gemSocketFilename": "PANEL/gemsocket",
            },
        },
        {
            "type": "TimerWidget",
            "name": "TimerClose",
            "fields": {
                "time": 0,
                "message": "PanelManager:OpenPanel:MiniCubeConsoleLayout"
            }
        },
        {
            "type": "TimerWidget",
            "name": "TimerClose",
            "fields": {
                "time": 0,
                "message": "PanelManager:ClosePanel:MiniCubeLayout"
            }
        }
    ]	
}
